{
  "name": "sheltie",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A suite of Herdr desktop mods and layouts, starting with ticket -> worktree -> agent -> PR -> merged",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import ./tests/register.mjs --test 'tests/*.test.mjs'",
    "typecheck": "tsc -p .",
    "check-built": "node scripts/build.mjs && git diff --exit-code -- mods sheltie.schema.json",
    "e2e": "node --test --test-concurrency=1 'tests/e2e/*.test.mjs'",
    "e2e:shots": "node --test tests/e2e/shots.mjs",
    "lint": "biome lint src scripts tests",
    "format": "biome check --write src scripts tests",
    "ci:lint": "biome ci src scripts tests"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3"
  }
}
