#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=demo/state.sh
. "$here/state.sh"

# Fake gh for herdr-demo: PR search, details (GraphQL), ready, merge (with auto-merge),
# review threads, the repo's merge method and repo clone, from the demo's state
# (state.sh); clones come from the demo's local remotes. Also GitHub issues
# (search, view with linked PRs, close) for the GitHub tracker.

demo="${HERDR_DEMO:?}"
state_tick

# `--repo <slug>` among the remaining arguments.
repo_arg() {
  while [ $# -gt 0 ]; do
    if [ "$1" = "--repo" ]; then
      echo "${2:-}"
      return
    fi
    shift
  done
}

# The PR in <slug> whose number or branch is <ref>, as JSON (exit 1 if none).
find_pr() {
  state_jq -e -c --arg ref "$2" --arg repo "$1" '
    [.prs[] | select(.repo == $repo and (.branch == $ref or (.number | tostring) == $ref))]
    | sort_by(if (.state // "OPEN") == "OPEN" then 0 else 1 end) | first // empty'
}

case "${1:-} ${2:-}" in
"search prs")
  state_jq '.prs | map({number, title, body, state: ((.state // "OPEN") | ascii_downcase), url: "https://github.com/\(.repo)/pull/\(.number)", repository: {nameWithOwner: .repo}})'
  ;;
"pr ready")
  slug="$(repo_arg "$@")"
  find_pr "$slug" "${3:-}" >/dev/null || {
    echo "no pull request ${3:-} in $slug" >&2
    exit 1
  }
  state_set --arg repo "$slug" --arg n "${3:-}" '(.prs[] | select(.repo == $repo and (.number | tostring) == $n)).draft = false'
  echo "✓ Pull request $slug#${3:-} is marked as \"ready for review\""
  ;;
"pr merge")
  slug="$(repo_arg "$@")"
  pr="$(find_pr "$slug" "${3:-}")" || {
    echo "no pull request ${3:-} in $slug" >&2
    exit 1
  }
  case " $* " in
  *" --auto "*)
    state_set --arg repo "$slug" --arg n "${3:-}" '(.prs[] | select(.repo == $repo and (.number | tostring) == $n)).autoMerge = true'
    state_tick
    echo "✓ Pull request $slug#${3:-} will be automatically merged when all requirements are met"
    ;;
  *)
    if [ "$(jq -r '.draft' <<<"$pr")" = true ]; then
      echo "Pull request $slug#${3:-} is still a draft" >&2
      exit 1
    fi
    state_set --arg repo "$slug" --arg n "${3:-}" '(.prs[] | select(.repo == $repo and (.number | tostring) == $n)) |= (.state = "MERGED" | .justMerged = true)'
    delete_merged_branches
    echo "✓ Merged pull request $slug#${3:-}"
    ;;
  esac
  ;;
"search issues")
  # Open issues, optionally only in the --repo ones (the assignee is ignored:
  # every demo issue is yours).
  repos="$(
    while [ $# -gt 0 ]; do
      if [ "$1" = "--repo" ]; then echo "${2:-}"; fi
      shift
    done | jq -R . | jq -s .
  )"
  state_jq --argjson repos "$repos" '
    [.issues // [] | .[] | select(.state == "OPEN" and (($repos | length) == 0 or (.repo as $r | $repos | index($r))))
     | {number, title, state, labels: (.labels // [] | map({name: .})), repository: {nameWithOwner: .repo}}]'
  ;;
"issue view")
  slug="$(repo_arg "$@")"
  n="${3:-}"
  state_jq -e --arg repo "$slug" --argjson n "${n:-0}" '
    (.prs) as $prs
    | [.issues // [] | .[] | select(.repo == $repo and .number == $n)] | first // empty
    | {number, title, state, labels: (.labels // [] | map({name: .})),
       closedByPullRequestsReferences: [$prs[] | select(.repo == $repo
          and ((.title // "") + " " + (.body // "")
               | test("(?i)(close[sd]?|fix(e[sd])?|resolve[sd]?) #\($n)\\b")))
          | {number, url: "https://github.com/\(.repo)/pull/\(.number)"}]}' || {
    echo "GraphQL: Could not resolve to an issue or pull request with the number of $n. (repository.issue)" >&2
    exit 1
  }
  ;;
"issue close")
  slug="$(repo_arg "$@")"
  state_set --arg repo "$slug" --argjson n "${3:-0}" '(.issues[] | select(.repo == $repo and .number == $n)).state = "CLOSED"'
  echo "✓ Closed issue $slug#${3:-}"
  ;;
"repo view")
  # The demo's repos default to squash in the web UI.
  echo "SQUASH"
  ;;
"api graphql")
  # Only prDetails' query, by PR number or branch: the GraphQL response.
  owner="" name="" ref=""
  for a in "$@"; do
    case "$a" in
    owner=*) owner="${a#owner=}" ;;
    name=*) name="${a#name=}" ;;
    number=* | branch=*) ref="${a#*=}" ;;
    esac
  done
  slug="$owner/$name"
  pr="$(find_pr "$slug" "$ref")" || pr=null
  if [ "$pr" = null ]; then
    case " $* " in
    *" number="*)
      echo "GraphQL: Could not resolve to a PullRequest with the number of $ref. (repository.pullRequest)" >&2
      exit 1
      ;;
    esac
    head=""
  else
    head="$(pr_head "$name" "$(jq -r .branch <<<"$pr")" "$(jq -r .number <<<"$pr")")"
  fi
  jq --arg head "$head" --arg by "$(case " $* " in *" number="*) echo number ;; *) echo branch ;; esac)" '
    (if . == null then null else
    {number, title, url: "https://github.com/\(.repo)/pull/\(.number)",
     state: (.state // "OPEN"), isDraft: .draft, reviewDecision: .review,
     headRefName: .branch, headRefOid: $head,
     autoMergeRequest: (if .autoMerge then {enabledAt: "now"} else null end),
     mergeable: (.mergeable // "MERGEABLE"),
     commits: {nodes: [{commit: {statusCheckRollup:
       (if .checks == null then null
        elif .checks == "IN_PROGRESS" then {contexts: {nodes: [{status: .checks, conclusion: null}]}}
        else {contexts: {nodes: [{conclusion: .checks}]}} end)}}]},
     reviewThreads: {nodes: ([range(.unresolved // 0)] | map({isResolved: false}))}} end) as $pr
    | {data: {repository: (if $by == "number" then {pullRequest: $pr}
                           else {pullRequests: {nodes: [$pr // empty]}} end)}}
  ' <<<"$pr"
  ;;
"repo clone")
  slug="${3:?}"
  path="${4:?}"
  name="${slug##*/}"
  git clone --quiet "$demo/remotes/$name.git" "$path"
  git -C "$path" remote set-url origin "https://github.com/$slug.git"
  git -C "$path" config "url.$demo/remotes/$name.git.insteadOf" "https://github.com/$slug.git"
  ;;
*)
  echo "herdr-demo gh: unsupported: $*" >&2
  exit 1
  ;;
esac
