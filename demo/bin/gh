#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=demo/state.sh
. "$here/state.sh"

# Fake gh for herdr-demo: PR search, details (GraphQL), ready, merge (with auto-merge),
# review threads, the review queue's search, pr checkout, the repo's merge
# method and repo clone, from the demo's state
# (state.sh); clones come from the demo's local remotes. Also GitHub issues
# (search, view with linked PRs, close) for the GitHub tracker.

demo="${HERDR_DEMO:?}"
state_tick

# `--repo <slug>` among the remaining arguments.
repo_arg() {
  while [ $# -gt 0 ]; do
    if [ "$1" = "--repo" ]; then
      echo "${2:-}"
      return
    fi
    shift
  done
}

# The PR in <slug> whose number or branch is <ref>, as JSON (exit 1 if none).
find_pr() {
  state_jq -e -c --arg ref "$2" --arg repo "$1" '
    [.prs[] | select(.repo == $repo and (.branch == $ref or (.number | tostring) == $ref))]
    | sort_by(if (.state // "OPEN") == "OPEN" then 0 else 1 end) | first // empty'
}

case "${1:-} ${2:-}" in
"search prs")
  state_jq '.prs | map({number, title, body, state: ((.state // "OPEN") | ascii_downcase), url: "https://github.com/\(.repo)/pull/\(.number)", repository: {nameWithOwner: .repo}})'
  ;;
"pr ready")
  slug="$(repo_arg "$@")"
  find_pr "$slug" "${3:-}" >/dev/null || {
    echo "no pull request ${3:-} in $slug" >&2
    exit 1
  }
  state_set --arg repo "$slug" --arg n "${3:-}" '(.prs[] | select(.repo == $repo and (.number | tostring) == $n)).draft = false'
  echo "✓ Pull request $slug#${3:-} is marked as \"ready for review\""
  ;;
"pr merge")
  slug="$(repo_arg "$@")"
  pr="$(find_pr "$slug" "${3:-}")" || {
    echo "no pull request ${3:-} in $slug" >&2
    exit 1
  }
  case " $* " in
  *" --auto "*)
    state_set --arg repo "$slug" --arg n "${3:-}" '(.prs[] | select(.repo == $repo and (.number | tostring) == $n)).autoMerge = true'
    state_tick
    echo "✓ Pull request $slug#${3:-} will be automatically merged when all requirements are met"
    ;;
  *)
    if [ "$(jq -r '.draft' <<<"$pr")" = true ]; then
      echo "Pull request $slug#${3:-} is still a draft" >&2
      exit 1
    fi
    state_set --arg repo "$slug" --arg n "${3:-}" '(.prs[] | select(.repo == $repo and (.number | tostring) == $n)) |= (.state = "MERGED" | .justMerged = true)'
    delete_merged_branches
    echo "✓ Merged pull request $slug#${3:-}"
    ;;
  esac
  ;;
"search issues")
  # Open issues, optionally only in the --repo ones (the assignee is ignored:
  # every demo issue is yours).
  repos="$(
    while [ $# -gt 0 ]; do
      if [ "$1" = "--repo" ]; then echo "${2:-}"; fi
      shift
    done | jq -R . | jq -s .
  )"
  state_jq --argjson repos "$repos" '
    [.issues // [] | .[] | select(.state == "OPEN" and (($repos | length) == 0 or (.repo as $r | $repos | index($r))))
     | {number, title, state, labels: (.labels // [] | map({name: .})), repository: {nameWithOwner: .repo}}]'
  ;;
"issue view")
  slug="$(repo_arg "$@")"
  n="${3:-}"
  state_jq -e --arg repo "$slug" --argjson n "${n:-0}" '
    (.prs) as $prs
    | [.issues // [] | .[] | select(.repo == $repo and .number == $n)] | first // empty
    | {number, title, state, labels: (.labels // [] | map({name: .})),
       closedByPullRequestsReferences: [$prs[] | select(.repo == $repo
          and ((.title // "") + " " + (.body // "")
               | test("(?i)(close[sd]?|fix(e[sd])?|resolve[sd]?) #\($n)\\b")))
          | {number, url: "https://github.com/\(.repo)/pull/\(.number)"}]}' || {
    echo "GraphQL: Could not resolve to an issue or pull request with the number of $n. (repository.issue)" >&2
    exit 1
  }
  ;;
"issue close")
  slug="$(repo_arg "$@")"
  state_set --arg repo "$slug" --argjson n "${3:-0}" '(.issues[] | select(.repo == $repo and .number == $n)).state = "CLOSED"'
  echo "✓ Closed issue $slug#${3:-}"
  ;;
"repo view")
  # The demo's repos default to squash in the web UI.
  echo "SQUASH"
  ;;
"api graphql")
  # The review queue's search (q=...): open PRs by others (with an author),
  # each requested of you (or a team, .requested[].team) minutesAgo, and
  # reviewed by you reviewedMinutesAgo. The search terms are ignored.
  case " $* " in
  *" q="*)
    state_jq '
      def ago(m): (now - m * 60 | floor | todate);
      {data: {viewer: {login: "me"}, search: {nodes: [.prs[]
        | select(.author and (.state // "OPEN") == "OPEN")
        | {number, title, additions: (.additions // 0), deletions: (.deletions // 0),
           url: "https://github.com/\(.repo)/pull/\(.number)",
           createdAt: ago((.requested // [] | map(.minutesAgo) | max) // 60),
           repository: {nameWithOwner: .repo}, author: {login: .author},
           timelineItems: {nodes: [.requested // [] | .[]
             | {createdAt: ago(.minutesAgo),
                requestedReviewer: (if .team then {__typename: "Team"}
                                    else {__typename: "User", login: "me"} end)}]},
           latestReviews: {nodes: [if .reviewedMinutesAgo then
             {author: {login: "me"}, submittedAt: ago(.reviewedMinutesAgo)} else empty end]}}]}}}'
    exit 0
    ;;
  esac
  # Otherwise prDetails' query (prs.js batchQuery): an alias per PR, p<i> by
  # number, b<i> by branch (its name in the variable b<i>). Each is answered
  # from the demo's PRs, null when there is none, as GitHub answers.
  owner="" name=""
  for a in "$@"; do
    case "$a" in
    owner=*) owner="${a#owner=}" ;;
    name=*) name="${a#name=}" ;;
    esac
  done
  slug="$owner/$name"
  query="$(for a in "$@"; do case "$a" in query=*) printf '%s\n' "${a#query=}" ;; esac; done)"
  data='{}'
  while read -r alias kind value; do
    ref="$value"
    if [ "$kind" = branch ]; then
      ref=""
      for a in "$@"; do case "$a" in "$value"=*) ref="${a#*=}" ;; esac; done
    fi
    pr="$(find_pr "$slug" "$ref")" || pr=null
    head=""
    if [ "$pr" != null ]; then
      head="$(pr_head "$name" "$(jq -r .branch <<<"$pr")" "$(jq -r .number <<<"$pr")")"
    fi
    node="$(jq --arg head "$head" '
    (if . == null then null else
    {number, title, url: "https://github.com/\(.repo)/pull/\(.number)",
     state: (.state // "OPEN"), isDraft: .draft, reviewDecision: .review,
     headRefName: .branch, baseRefName: (.base // "main"), headRefOid: $head,
     autoMergeRequest: (if .autoMerge then {enabledAt: "now"} else null end),
     mergeable: (.mergeable // "MERGEABLE"),
     commits: {nodes: [{commit: {statusCheckRollup:
       # .optionalChecks: conclusions of checks not required for merging.
       ((if .checks == null then []
         elif .checks == "IN_PROGRESS" then [{status: .checks, conclusion: null, isRequired: true}]
         else [{conclusion: .checks, isRequired: true}] end)
        + ((.optionalChecks // []) | map({conclusion: ., isRequired: false}))
        | if length == 0 then null else {contexts: {nodes: .}} end)}}]},
     reviewThreads: {nodes: ([range(.unresolved // 0)] | map({isResolved: false}))}} end)
  ' <<<"$pr")"
    # updatedAt: a checksum of the node, so it changes whenever the PR does (as
    # GitHub's does, for what the probe (prs.js probePRs) looks at).
    if [ "$node" != null ]; then
      sum="$(printf '%s' "$node" | cksum | cut -d' ' -f1)"
      node="$(jq --arg u "demo-$sum" '. + {updatedAt: $u}' <<<"$node")"
    fi
    if [ "$kind" = number ]; then
      v="$node"
    else
      v="$(jq -n --argjson n "$node" 'if $n == null then {nodes: []} else {nodes: [$n]} end')"
    fi
    data="$(jq --arg k "$alias" --argjson v "$v" '. + {($k): $v}' <<<"$data")"
  done < <(grep -oE '[pb][0-9]+: pullRequests?\((number: [0-9]+|headRefName: \$[pb][0-9]+)' <<<"$query" |
    sed -E 's/^([pb][0-9]+): pullRequest\(number: ([0-9]+)/\1 number \2/; s/^([pb][0-9]+): pullRequests\(headRefName: \$([pb][0-9]+)/\1 branch \2/')
  jq -n --argjson r "$data" '{data: {repository: $r}}'
  ;;
"pr checkout")
  # In a clone of a demo repo: the PR's head (refs/pull/<n>/head, so forks
  # work too) on a local branch named after the PR's.
  url="$(git config --get remote.origin.url)"
  slug="${url#https://github.com/}"
  slug="${slug%.git}"
  pr="$(find_pr "$slug" "${3:-}")" || {
    echo "GraphQL: Could not resolve to a PullRequest with the number of ${3:-}. (repository.pullRequest)" >&2
    exit 1
  }
  pr_head "${slug##*/}" "$(jq -r .branch <<<"$pr")" "${3:-}" >/dev/null
  git fetch --quiet origin "refs/pull/${3:-}/head"
  git checkout --quiet -B "$(jq -r .branch <<<"$pr")" FETCH_HEAD
  ;;
"repo clone")
  slug="${3:?}"
  path="${4:?}"
  name="${slug##*/}"
  git clone --quiet "$demo/remotes/$name.git" "$path"
  git -C "$path" remote set-url origin "https://github.com/$slug.git"
  git -C "$path" config "url.$demo/remotes/$name.git.insteadOf" "https://github.com/$slug.git"
  ;;
*)
  echo "herdr-demo gh: unsupported: $*" >&2
  exit 1
  ;;
esac
